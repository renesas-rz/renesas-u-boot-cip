		pinmux = <RZG2L_PINMUX(5, 0, 1)>,	/* VBUS	*/
			 <RZG2L_PINMUX(5, 2, 1)>;	/* OVC	*/
	};

	usb1_pins: usb1 {
		pinmux = <RZG2L_PINMUX(6, 0, 1)>,	/* VBUS	*/
			 <RZG2L_PINMUX(5, 4, 5)>;	/* OVC */
	};
};
